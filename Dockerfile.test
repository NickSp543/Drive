FROM ubuntu:22.04

RUN apt-get update && \
    apt-get install -y g++ cmake make libgtest-dev && \
    apt-get clean

RUN cd /usr/src/gtest && \
    cmake . && \
    make && \
    mv lib/*.a /usr/lib

WORKDIR /app

COPY src/ ./src/
COPY tests/ ./tests/

RUN g++ -std=gnu++17 \
        src/InputChecker.cpp \
        src/Compressor.cpp \
        src/AddCommand.cpp \
        src/GetCommand.cpp \
        src/SearchCommand.cpp \
        src/DeleteCommand.cpp \
        tests/InputCheckerTest.cpp \
        tests/CompressorAddTest.cpp \
        tests/CompressorGetTest.cpp \
        tests/CompressorDeleteTest.cpp \
        tests/test_Compressor_search.cpp \
        tests/AddCommandTest.cpp \
        tests/GetCommandTest.cpp \
        tests/SearchCommandTest.cpp \
        tests/DeleteCommandTest.cpp \
        -I./src \
        -lgtest -lgtest_main -pthread \
        -o tests_run

CMD ["./tests_run"]
